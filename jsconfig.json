{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "checkJs": false,
    "paths": {
      "#root/*": ["./*"],
      "#src/*": ["./src/*"],
      "#app/*": ["./src/app/*"],
      "#core/*": ["./src/core/*"],
      "#modules/*": ["./src/modules/*"],
      "#infra/*": ["./src/infrastructure/*"],
      "#presentation/*": ["./src/presentation/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
