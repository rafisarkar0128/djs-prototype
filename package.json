{
  "name": "djs-prototype",
  "version": "5.0.0-snapshot",
  "description": "A lightweight, modern multipurpose Discord bot template built with discord.js.",
  "type": "module",
  "main": "src/index.js",
  "imports": {
    "#root/*": "./*",
    "#src/*": "./src/*",
    "#db/*": "./src/db/*",
    "#utils/*": "./src/utils/*",
    "#helpers/*": "./src/helpers/*",
    "#structures/*": "./src/structures/*"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "shard": "node src/shard.js",
    "devShard": "node --watch src/shard.js",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "prettier --write .",
    "clearGlobal": "node scripts/clearGlobal.js",
    "clearGuild": "node scripts/clearGuild.js"
  },
  "keywords": [
    "bot",
    "template",
    "bot-template",
    "discord",
    "discord-bot",
    "discord-bot-template",
    "javascript",
    "nodejs",
    "discordjs"
  ],
  "author": "rafisarkar0128",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafisarkar0128/djs-prototype.git"
  },
  "bugs": {
    "url": "https://github.com/rafisarkar0128/djs-prototype/issues"
  },
  "homepage": "https://github.com/rafisarkar0128/djs-prototype#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "undici": "^7.30.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "discord-arts": "^0.7.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "figures": "^6.1.0",
    "genius-lyrics": "^4.4.7",
    "glob": "^13.0.6",
    "i18next": "^25.10.10",
    "i18next-fs-backend": "^2.6.8",
    "lavalink-client": "^2.11.0",
    "lru-cache": "^11.5.3",
    "luxon": "^3.7.2",
    "mongodb": "^7.7.0",
    "ms": "^2.1.3",
    "node-system-stats": "^2.0.5",
    "readline": "^1.3.0",
    "table": "^6.9.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6",
    "zlib-sync": "^0.1.10"
  }
}
