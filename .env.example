# ==========================================
# Application & Environment
# ==========================================
NODE_ENV="development" # "development" | "production"
DEFAULT_LOCALE="en-US"

# ==========================================
# Logging Configurations (SLF4J Pattern)
# ==========================================
LOG_LEVEL="info" # "debug" | "info" | "warn" | "error" | "fatal" | "silent"
# Fine-grained scope overrides: SCOPE:LEVEL,SCOPE:LEVEL (e.g. "DATABASE:debug,MUSIC:trace")
LOG_SCOPES=""
LOG_SCOPE_COLORS=""

LOG_TO_FILE=false
LOG_DIR_PATH="./logs/"
LOG_DATE_FORMAT="[dd/MM/yyyy]"
LOG_TIME_FORMAT="[h:mm:ss a]"
LOG_DISPLAY_TIME=true
LOG_DISPLAY_DATE=true
LOG_DISPLAY_SCOPE=true
LOG_DISPLAY_FILE=true
LOG_DISPLAY_BADGE=true
LOG_DISPLAY_LABEL=true
LOG_UPPERCASE_LABEL=true

# Loader Table Visualizations
SHOW_TABLE_EVENT=false
SHOW_TABLE_COMMAND=false

# ==========================================
# Discord Credentials & Bot Settings
# ==========================================
DISCORD_CLIENT_TOKEN="YOUR_DISCORD_TOKEN"
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_SECRET"

# Bot Behavior Settings
DISCORD_CLIENT_DEFAULT_PREFIX="!"
DISCORD_CLIENT_OWNER_ID="YOUR_DISCORD_USER_ID_HERE"
DISCORD_CLIENT_GUILD_ID="YOUR_GUILD_ID_HERE"
# Accepts JSON array '["123", "456"]' or comma-separated "123,456"
DISCORD_CLIENT_DEV_IDS="YOUR_DISCORD_USER_ID_HERE"

DISCORD_CLIENT_GLOBAL_COMMANDS=true
DISCORD_CLIENT_ALLOWED_INVITE=true
DISCORD_CLIENT_DEFAULT_COOLDOWN=5
SHOW_SYNC_LOGS=true

# ==========================================
# Database Configuration (MongoDB)
# ==========================================
MONGO_URI="mongodb://127.0.0.1:27017"
MONGO_DB_NAME="djs-prototype"
CACHE_GUILD_MAX=25000
CACHE_USER_MAX=50000

# ==========================================
# Notification Channels & Webhooks
# ==========================================
CHANNEL_GENERAL="YOUR_CHANNEL_ID_HERE"
CHANNEL_ERROR="YOUR_CHANNEL_ID_HERE"
CHANNEL_COMMAND="YOUR_CHANNEL_ID_HERE"

WEBHOOK_GENERAL="YOUR_WEBHOOK_URL_HERE"
WEBHOOK_ERROR="YOUR_WEBHOOK_URL_HERE"
WEBHOOK_COMMAND="YOUR_WEBHOOK_URL_HERE"

# ==========================================
# External Links
# ==========================================
SUPPORT_SERVER="https://discord.gg/YOUR_INVITE_CODE"
BOT_WEBSITE="https://rafisarkar0128.github.io/djs-prototype/"
GITHUB_REPO="https://github.com/rafisarkar0128/djs-prototype#readme"